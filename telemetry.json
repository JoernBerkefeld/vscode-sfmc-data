{
    "commonProperties": {
        "distinct_id": {
            "classification": "EndUserPseudonymizedInformation",
            "purpose": "FeatureInsight",
            "comment": "Stable pseudonymous VS Code machine identifier used to distinguish installations without collecting personal data."
        },
        "$process_person_profile": {
            "classification": "SystemMetaData",
            "purpose": "FeatureInsight",
            "comment": "Always false so PostHog does not create or update person profiles."
        },
        "extension": {
            "classification": "SystemMetaData",
            "purpose": "FeatureInsight",
            "comment": "Short emitting extension name, always sfmc-data."
        },
        "extensionVersion": {
            "classification": "SystemMetaData",
            "purpose": "FeatureInsight",
            "comment": "Version of the emitting extension."
        },
        "os": {
            "classification": "SystemMetaData",
            "purpose": "FeatureInsight",
            "comment": "Host operating-system platform."
        },
        "vscodeVersion": {
            "classification": "SystemMetaData",
            "purpose": "FeatureInsight",
            "comment": "Version of the host editor."
        }
    },
    "events": {
        "extension.activated": {
            "owner": "joernberkefeld",
            "comment": "Emitted once after extension initialization with project, mcdata source, and related-extension presence booleans. Omits neighbor.sfmc-data because this extension is the emitter.",
            "properties": {
                "isMcdevProject": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether any workspace folder root contains .mcdevrc.json."
                },
                "isMcdataProject": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether any workspace folder root contains .mcdatarc.json."
                },
                "mcdataSource": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Resolved sfmcData.mcdataSource setting: bundled, auto, or custom."
                },
                "coInstalledAsDependency": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether another installed extension lists this extension as a dependency."
                },
                "coInstalledInPack": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether another installed extension includes this extension in its pack."
                },
                "neighbor.sergey-agadzhanov.ampscript": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether sergey-agadzhanov.ampscript is installed."
                },
                "neighbor.FiB.ssjs-vsc": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether FiB.ssjs-vsc is installed."
                },
                "neighbor.FiB.beautyAmp": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether FiB.beautyAmp is installed."
                },
                "neighbor.sfmc-language": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether joernberkefeld.sfmc-language is installed."
                },
                "neighbor.sfmc-devtools": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether Accenture-oss.sfmc-devtools-vscode is installed."
                },
                "neighbor.mso-conditionals": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether joernberkefeld.mso-conditionals is installed."
                },
                "neighbor.sfmc-extension-pack": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether joernberkefeld.sfmc-extension-pack is installed."
                },
                "neighbor.sfmc-extension-pack-plus": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether joernberkefeld.sfmc-extension-pack-expanded is installed."
                },
                "neighbor.markdown-preview-bitbucket-innersource": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Whether joernberkefeld.markdown-preview-bitbucket-innersource is installed."
                }
            }
        },
        "command.executed": {
            "owner": "joernberkefeld",
            "comment": "Emitted when a dispatcher command or refresh-cache handler finishes successfully.",
            "properties": {
                "command": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "VS Code command identifier, for example sfmc-data.exportDE."
                }
            },
            "measures": {
                "durationMs": {
                    "classification": "SystemMetaData",
                    "purpose": "PerformanceAndHealth",
                    "comment": "Wall-clock command duration in milliseconds."
                },
                "buCount": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Optional count of business units processed by refresh-cache. Omitted for dispatcher commands."
                }
            }
        },
        "command.failed": {
            "owner": "joernberkefeld",
            "comment": "Emitted when a dispatcher command or refresh-cache handler fails; no raw error message, stack, or path is collected.",
            "properties": {
                "command": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "VS Code command identifier, for example sfmc-data.exportDE."
                },
                "errorCategory": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Coarse fixed failure category: commandFailed, spawnError, or mcdataPrefixMissing. Never a raw error value."
                },
                "errorName": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Optional. Short Error.name identifier when it matches a safe pattern. Never a message."
                },
                "errorCode": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Optional. Sanitized error.code or a small integer exit code as a string. Never a path."
                }
            },
            "measures": {
                "buCount": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Optional count of business units processed by refresh-cache. Omitted for dispatcher commands."
                }
            }
        },
        "mcdata.version": {
            "owner": "joernberkefeld",
            "comment": "Emitted once per session after the resolved mcdata --version lookup settles. mcdataVersion is omitted when lookup fails.",
            "properties": {
                "mcdataVersion": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Resolved mcdata CLI version, omitted when lookup fails or returns no version."
                },
                "mcdataSource": {
                    "classification": "SystemMetaData",
                    "purpose": "FeatureInsight",
                    "comment": "Resolved sfmcData.mcdataSource setting: bundled, auto, or custom."
                }
            }
        }
    }
}
